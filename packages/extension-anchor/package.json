{
  "name": "anchor-explain",
  "displayName": "Anchor Explain",
  "description": "把选中的一段内容变成带地址的锚点：AI 讲解并逐步高亮流转。核心命题——截图 = 带地址的锚点，不是像素包。",
  "version": "0.1.0",
  "private": true,
  "publisher": "Fish-zjuer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish-zjuer/anchor-explain.git",
    "directory": "packages/extension-anchor"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:anchorExplain.capture",
    "onCommand:anchorExplain.explainAnchor",
    "onCommand:anchorExplain.next",
    "onCommand:anchorExplain.prev",
    "onCommand:anchorExplain.stop",
    "onCommand:anchorExplain.goto",
    "onCommand:anchorExplain.playPause",
    "onCommand:anchorExplain.showStart",
    "onCommand:anchorExplain.openSettings",
    "onCommand:anchorExplain.configure",
    "onCommand:anchorExplain.showState",
    "onCommand:anchorExplain.setApiKey",
    "onCommand:anchorExplain.replayLast",
    "onCommand:anchorExplain.reExplain",
    "onView:anchorExplain.start"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anchor",
          "title": "Anchor",
          "icon": "assets/anchor.svg"
        }
      ]
    },
    "views": {
      "anchor": [
        {
          "type": "webview",
          "id": "anchorExplain.start",
          "name": "开始"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "开始使用 Anchor",
        "description": "把一段代码或一块 PDF 区域变成带地址的锚点：AI 讲解，并逐点高亮流转。",
        "steps": [
          {
            "id": "setup",
            "title": "配一个模型端点",
            "description": "三个输入框写好端点与模型名，再把 API Key 存进 SecretStorage（不进 settings.json）。\n[配置模型端点](command:anchorExplain.configure)\n[设置 API Key](command:anchorExplain.setApiKey)\n[显示当前配置](command:anchorExplain.showState)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": ["onCommand:anchorExplain.setApiKey"]
          },
          {
            "id": "capture",
            "title": "讲解选中的代码",
            "description": "在编辑器里选中一段，按快捷键，或从活动栏的「开始」面板点。\n[打开开始面板](command:anchorExplain.showStart)",
            "media": {
              "markdown": "media/walkthrough/capture.md"
            },
            "completionEvents": ["onCommand:anchorExplain.capture"]
          },
          {
            "id": "flow",
            "title": "跟着讲解流转",
            "description": "讲解是一步一步的：先铺整段的范围，再逐个逻辑点扫过去。\n[显示状态](command:anchorExplain.showState)",
            "media": {
              "markdown": "media/walkthrough/flow.md"
            },
            "completionEvents": ["onCommand:anchorExplain.next"]
          },
          {
            "id": "pdf",
            "title": "框选一块 PDF（线2）",
            "description": "PDF 上不画任何高亮框：框选出来的位置只用来定位与取件。\n[用 Anchor 打开 PDF](command:anchorPdf.openInAnchorViewer)",
            "media": {
              "markdown": "media/walkthrough/pdf.md"
            },
            "completionEvents": ["onCommand:anchorPdf.selectRegion"]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "anchorExplain.capture",
        "title": "捕获选区并讲解",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.explainAnchor",
        "title": "讲解外部锚点",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.addSegment",
        "title": "把选中的一段加入多段队列",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.explainSegments",
        "title": "讲解多段队列里的全部段",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.removeSegment",
        "title": "从多段队列里移除一段",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.clearSegments",
        "title": "清空多段队列",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.replayLast",
        "title": "重放上次讲解（不再问模型）",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.reExplain",
        "title": "重新讲一遍（再问一次模型）",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.next",
        "title": "下一步",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.prev",
        "title": "上一步",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.stop",
        "title": "退出讲解",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.goto",
        "title": "跳到指定步",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.playPause",
        "title": "播放或暂停",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.showStart",
        "title": "打开开始界面",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.showState",
        "title": "显示状态",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.configure",
        "title": "配置模型端点（写进设置）",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.openSettings",
        "title": "打开设置（配模型端点）",
        "category": "Anchor"
      },
      {
        "command": "anchorExplain.setApiKey",
        "title": "设置 API Key（存进 SecretStorage）",
        "category": "Anchor"
      }
    ],
    "keybindings": [
      {
        "command": "anchorExplain.capture",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "anchorExplain.addSegment",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorTextFocus"
      },
      {
        "command": "anchorExplain.showStart",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "!inputFocus"
      },
      {
        "command": "anchorExplain.next",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "anchorExplain.walkthroughActive"
      },
      {
        "command": "anchorExplain.prev",
        "key": "alt+[",
        "mac": "alt+[",
        "when": "anchorExplain.sessionOpen"
      },
      {
        "command": "anchorExplain.stop",
        "key": "escape",
        "mac": "escape",
        "when": "anchorExplain.sessionOpen && !inputFocus"
      },
      {
        "command": "anchorExplain.goto",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "anchorExplain.sessionOpen"
      },
      {
        "command": "anchorExplain.playPause",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space",
        "when": "anchorExplain.walkthroughActive"
      }
    ],
    "configuration": {
      "title": "Anchor",
      "properties": {
        "anchorExplain.providers": {
          "type": "object",
          "default": {},
          "markdownDescription": "模型端点。键是 provider id，值是 `{ baseUrl, tier1Model, tier2Model?, apiKey?, extraHeaders?, extraBody? }`。\n\n例：`{ \"default\": { \"baseUrl\": \"https://api.deepseek.com/v1\", \"tier1Model\": \"deepseek-chat\" } }`\n\n**`apiKey` 建议留空**，改用命令 `Anchor: 设置 API Key` 存进 SecretStorage —— 那个位置不进 settings.json，也就不会被同步、被截图、被提交。",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string"
              },
              "tier1Model": {
                "type": "string"
              },
              "tier2Model": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "extraHeaders": {
                "type": "object"
              },
              "extraBody": {
                "type": "object"
              }
            },
            "required": [
              "baseUrl",
              "tier1Model"
            ]
          }
        },
        "anchorExplain.activeProvider": {
          "type": "string",
          "default": "default",
          "description": "用 anchorExplain.providers 里的哪一个。"
        },
        "anchorExplain.maxFetchRounds": {
          "type": "number",
          "default": 3,
          "maximum": 20,
          "minimum": 0,
          "description": "AI 请求额外上下文的次数上限。超过之后取件请求会被拒绝，并让它基于现有信息作答。"
        },
        "anchorExplain.maxFetchLines": {
          "type": "number",
          "default": 400,
          "minimum": 1,
          "maximum": 2000,
          "markdownDescription": "一次最多取多少**行**。嵌入式的一个头文件动辄一两百行，默认给到 400；要多了不会被拒，只会**截到上限**（回灌的内容头部会写清真实行范围）。"
        },
        "anchorExplain.fetchScope": {
          "type": "string",
          "enum": [
            "related",
            "same-dir",
            "off"
          ],
          "default": "related",
          "enumDescriptions": [
            "相关文件（默认）：可以读工作区里跟这一块有关的其他文件 —— 宏、结构体、调用者常常不在同一个文件里。",
            "同目录：只读锚点文件所在目录里的文件。",
            "关闭：只读锚点所在的文件（跨文件讲解之前的行为）。"
          ],
          "markdownDescription": "允许 AI 读**锚点文件之外**哪些文件。密钥（`.env*`/`*.pem`/`id_rsa*`）、依赖（`node_modules`）、构建产物目录始终不读。"
        },
        "anchorExplain.style": {
          "type": "string",
          "enum": [
            "concise",
            "rigorous"
          ],
          "default": "concise",
          "enumDescriptions": [
            "简约：说人话，能用大白话讲清的就不用术语。一句话一个动作。",
            "严谨：术语可以用，但每个都要落到这段代码的具体位置上，并说清依据（不变量、边界、返回值）。"
          ],
          "markdownDescription": "讲解风格（两档都要求**按数据怎么流**组织步骤，而不是从上到下一行行念）。"
        },
        "anchorExplain.preferSecretStorage": {
          "type": "boolean",
          "default": true,
          "description": "apiKey 优先从 SecretStorage 读，取不到才回落到 providers 里的 apiKey。"
        },
        "anchorExplain.temperature": {
          "type": "number",
          "description": "透传给模型端点。留空则用端点的默认值。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@anchor/core": "workspace:*",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.9.2"
  }
}
