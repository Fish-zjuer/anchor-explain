{
  "name": "anchor-explain-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "跨场景 AI 截图讲解系统 —— 单仓库两扩展 + 一共享包。核心命题：截图 = 带地址的锚点。",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "fixtures": "node scripts/make-fixture-pdf.mjs",
    "devhost": "pnpm build && node scripts/devhost.mjs",
    "devhost:pdf": "pnpm build && node scripts/devhost.mjs line2",
    "link:ext": "pnpm build && node scripts/link-extension.mjs",
    "unlink:ext": "node scripts/link-extension.mjs --uninstall",
    "preview:sidebar": "node scripts/preview-sidebar.mjs --serve",
    "preview:blocks": "node scripts/preview-blocks.mjs --serve",
    "style:lab": "node packages/extension-anchor/scripts/style-lab.ts",
    "smoke": "node scripts/smoke-extension.mjs",
    "smoke:chain": "node scripts/smoke-walkthrough.mjs",
    "smoke:fileswitch": "node scripts/smoke-file-switch.mjs",
    "check": "pnpm check:inline && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm smoke:chain && pnpm smoke:fileswitch && pnpm smoke:pdf",
    "smoke:pdf": "node scripts/smoke-pdf-extension.mjs",
    "package:vsix": "pnpm build && node scripts/package-vsix.mjs",
    "package:vsix:line1": "pnpm build && node scripts/package-vsix.mjs line1",
    "package:vsix:line2": "pnpm build && node scripts/package-vsix.mjs line2",
    "check:inline": "node scripts/check-inline-strings.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
