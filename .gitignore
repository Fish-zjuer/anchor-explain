# 依赖与构建产物
node_modules/
# 写成 packages/*/dist/ 而**不是** dist/：后者是泛匹配，会连
# packages/extension-anchor-pdf/assets/pdf.js/ 里任何同名目录一起忽略 ——
# 那是上游 vendored 源码，必须提交（见文件末尾说明）。
packages/*/dist/
out/

# 打包产物
*.vsix
release/

# VS Code 集成测试下载的编辑器
.vscode-test/

# 日志与临时文件
*.log
*.tsbuildinfo

# 侧边栏排版预览的产物（scripts/preview-sidebar.mjs 生成，随时可重建）
.tmp-preview/

# 冒烟脚本在进程内打出来的临时产物（scripts/smoke-file-switch.mjs 等，随时可重建）
.tmp-smoke/
.tmp-repro/

# 排查时把命令输出落盘再看的散装临时文件（Windows 上 PowerShell 的 stdout 不回显，
# 只能先写文件再读 —— 见 docs/STATE.md 的"这台机器上的操作注意"）。
# 一律 `.tmp-` 开头，方便一眼认出是垃圾；**别拿它存任何要看的东西**。
.tmp-*.txt
.tmp-*.json

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 说明：以下路径是**上游 vendored 源码，必须提交**，切勿加入忽略
#   packages/extension-anchor-pdf/assets/pdf.js/
#   packages/extension-anchor-pdf/patches/
